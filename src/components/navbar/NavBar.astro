---
import NavElement from "./NavElement.astro";
import "../../styles/index.css";
import ContactIcon from "./ContactIcon.astro";
import MenuIcon from "../../icons/menu.svg";
import CloseIcon from "../../icons/close.svg";
import "../../styles/search-bar.css";

type Props = {
  class?: string;
  selectedPage: "About" | "Projects" | "Blog";
};

const { class: className, selectedPage } = Astro.props;
---

<nav
  class=`text-[13pt] mx-[5%] sm:text-[15pt] py-4 flex flex-col justify-between sm:flex-row items-center sm:items-stretch ${className}`
>
  <div
    class="is-in-mobile-menu flex items-center max-sm:mt-5 max-sm:hidden max-sm:flex-col max-sm:gap-5 min-md:justify-stretch"
  >
    <NavElement
      name="About"
      href="/about"
      isSelected={selectedPage === "About"}
      class="mx-6.5"
    />
    <NavElement
      name="Projects"
      href="/projects/page/1"
      isSelected={selectedPage === "Projects"}
      class="mx-6.5"
    />
    <NavElement
      name="Blog"
      href="/blog/page/1"
      isSelected={selectedPage === "Blog"}
      class="mx-6.5"
    />
  </div>
  <div class="flex max-sm:order-first max-sm:w-full max-sm:justify-between">
    <button type="button" class="hidden cursor-pointer max-sm:block">
      <MenuIcon id="open-menu-icon" class="size-8" />
      <CloseIcon id="close-menu-icon" class="hidden size-8" />
    </button>
    <div class="flex items-center justify-stretch">
      <div class="flex justify-stretch max-sm:mr-[5%]">
        <ContactIcon name="github-logo" url="https://github.com/gabor-hosu" />
        <ContactIcon name="gmail-logo" url="mailto:contact@hgabor.com" />
      </div>
      <a
        href="/resume/cv_gabor_hosu.pdf"
        download
        class="ml-1 flex items-center justify-center rounded-xl bg-green-500 px-2 py-1 font-semibold text-white shadow transition-colors duration-200 hover:bg-green-600 md:ml-10"
      >
        Resume
      </a>
    </div>
  </div>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const button = document.querySelectorAll("button")[0];

    button.addEventListener("click", () => {
      const openMenuIcon = document.getElementById("open-menu-icon");
      const closeMenuIcon = document.getElementById("close-menu-icon");
      const components = document.getElementsByClassName("is-in-mobile-menu");

      for (const comp of components) {
        comp.classList.toggle("max-sm:hidden");
      }

      openMenuIcon?.classList.toggle("hidden");
      closeMenuIcon?.classList.toggle("hidden");
    });
  });
</script>
